# Supabase — use a dedicated TEST project, never the production project
SUPABASE_URL=https://your-test-project.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# RevenueCat — use sandbox mode
REVENUECAT_API_KEY=your-sandbox-api-key

# Dashboard ingestion (set in GitHub Actions secrets)
DASHBOARD_SUPABASE_URL=https://your-dashboard-project.supabase.co
DASHBOARD_SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
